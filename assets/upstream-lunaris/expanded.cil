; Pong-Development/hardware_dolby @ 6300a4e30757d5810d62b2df0cff973ec438a70f
; hal_dms_default.te / hal_server_domain + type attribute memberships
(typeattributeset domain (hal_dms_default))
(typeattributeset halserverdomain (hal_dms_default))
(typeattributeset hal_dms (hal_dms_default))
(typeattributeset hal_dms_server (hal_dms_default))
(typeattributeset exec_type (hal_dms_default_exec))
(typeattributeset vendor_file_type (hal_dms_default_exec))
(typeattributeset file_type (hal_dms_default_exec))
(typeattributeset hwservice_manager_type (hal_dms_hwservice))
; init_daemon_domain
(allow init hal_dms_default_exec (file (getattr open read execute map)))
(allow init hal_dms_default (process (transition)))
(allow hal_dms_default hal_dms_default_exec (file (entrypoint open read execute getattr map)))
(dontaudit init hal_dms_default (process (noatsecure)))
(allow init hal_dms_default (process (siginh rlimitinh)))
(typetransition init hal_dms_default_exec process hal_dms_default)
; rw_file_perms includes ioctl, lock, watch/watch_reads, append and map.
; Keep the upstream directory rule's actual rw_file_perms, not a guessed replacement.
(allow hal_dms_default vendor_data_file (file (getattr open read ioctl lock map watch watch_reads append write create unlink)))
(allow hal_dms_default vendor_data_file (dir (getattr open read ioctl lock map watch watch_reads append write add_name remove_name)))
(allow hal_dms_default mediacodec (binder (call)))
(allow hal_dms_default property_socket (sock_file (write)))
(allow hal_dms_default init (unix_stream_socket (connectto)))
(allow hal_dms_default vendor_audio_prop (file (getattr open read map)))
; hal_audio_default.te + hal_dms_default.te binder_call pairs
(allow hal_audio_default hal_dms_hwservice (hwservice_manager (find)))
(allow hal_audio_default hal_dms_default (binder (call transfer)))
(allow hal_dms_default hal_audio_default (binder (transfer)))
(allow hal_audio_default hal_dms_default (fd (use)))
(allow hal_dms_default hal_audio_default (binder (call transfer)))
(allow hal_audio_default hal_dms_default (binder (transfer)))
(allow hal_dms_default hal_audio_default (fd (use)))
; hal_dms.te / binder_call in both directions + add_hwservice + find
(allow hal_dms_client hal_dms_server (binder (call transfer)))
(allow hal_dms_server hal_dms_client (binder (transfer)))
(allow hal_dms_client hal_dms_server (fd (use)))
(allow hal_dms_server hal_dms_client (binder (call transfer)))
(allow hal_dms_client hal_dms_server (binder (transfer)))
(allow hal_dms_server hal_dms_client (fd (use)))
(allow hal_dms_server hal_dms_hwservice (hwservice_manager (add find)))
(allow hal_dms_server hidl_base_hwservice (hwservice_manager (add)))
(allow hal_dms_client hal_dms_hwservice (hwservice_manager (find)))
; mediacodec.te
(allow mediacodec hal_dms_hwservice (hwservice_manager (find)))
(allow mediacodec hal_dms_default (binder (call transfer)))
(allow hal_dms_default mediacodec (binder (transfer)))
(allow mediacodec hal_dms_default (fd (use)))
; platform_app.te + hal_dms_default.te binder_call pairs
(allow platform_app hal_dms_hwservice (hwservice_manager (find)))
(allow platform_app hal_dms_default (binder (call transfer)))
(allow hal_dms_default platform_app (binder (transfer)))
(allow platform_app hal_dms_default (fd (use)))
(allow hal_dms_default platform_app (binder (call transfer)))
(allow platform_app hal_dms_default (binder (transfer)))
(allow hal_dms_default platform_app (fd (use)))
